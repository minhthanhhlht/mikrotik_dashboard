# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf

# Binary files (never touch line endings)
*.woff2 binary
*.woff binary
*.ttf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.backup binary

