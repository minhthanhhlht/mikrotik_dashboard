# ============================================
# Cấu hình MikroTik (dùng khi chạy thật)
# ============================================
# Scheme: http hoặc https
MTIK_SCHEME=http
# Địa chỉ IP của router MikroTik (thường là cổng gateway)
MTIK_HOST=192.168.88.1
# Cổng REST API (mặc định 80 cho http, 443 cho https)
MTIK_PORT=80
# Tài khoản đăng nhập API (nên tạo user riêng, không dùng admin)
MTIK_USER=admin
MTIK_PASS=some_random_password

# ============================================
# Cổng chạy backend proxy
# ============================================
PORT=3000

# ============================================
# Lưu ý: Tài khoản đăng nhập Dashboard được xác thực
# trực tiếp từ bảng /user trên MikroTik RouterOS.
# ============================================