# ==============================================================================
# CẤU HÌNH KẾT NỐI MIKROTIK ROUTEROS 7 REST API
# ==============================================================================
MTIK_SCHEME=http
MTIK_HOST=192.168.88.1
MTIK_PORT=80
MTIK_USER=admin
MTIK_PASS=your_password_here
PORT=3000

# ==============================================================================
# CẤU HÌNH NGUỒN XÁC THỰC TÀI KHOẢN ĐĂNG NHẬP DASHBOARD (AUTH_SOURCE)
# ------------------------------------------------------------------------------
# Tùy chọn:
#   - 'routeros' : (Mặc định) Xác thực trực tiếp qua tài khoản RouterOS (/user).
#   - 'env'      : Chỉ xác thực qua các tài khoản định nghĩa dưới đây trong file .env.
#   - 'both'     : Kết hợp cả hai (Ưu tiên tài khoản .env, nếu không khớp sẽ thử tiếp qua RouterOS).
# ==============================================================================
AUTH_SOURCE=both

# ------------------------------------------------------------------------------
# DANH SÁCH TÀI KHOẢN KHI DÙNG AUTH_SOURCE=env HOẶC AUTH_SOURCE=both
# ------------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=Admin@123
ADMIN_ROLE=admin
ADMIN_NAME=Administrator

OPERATOR_USER=operator
OPERATOR_PASS=Operator@123
OPERATOR_ROLE=operator
OPERATOR_NAME=Operator

VIEWER_USER=viewer
VIEWER_PASS=Viewer@123
VIEWER_ROLE=viewer
VIEWER_NAME=Viewer

# ==============================================================================
# CẤU HÌNH KẾT NỐI PROXMOX VE HYPERVISOR 7.X / 8.X REST API
# ==============================================================================
PROXMOX_HOST=
PROXMOX_PORT=8006
PROXMOX_SCHEME=https

# --- Cách 1: Xác thực qua API Token (Khuyến nghị) ---
PROXMOX_TOKEN_ID=root@pam!dashboard
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Cách 2: Xác thực qua Tài khoản (Nếu không dùng API Token) ---
# PROXMOX_USER=root@pam
# PROXMOX_PASS=your_proxmox_password

PROXMOX_NODE=
PROXMOX_IGNORE_SSL=true